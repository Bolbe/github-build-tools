name: Build Static Qt (macOS) Apple Silicon only.

on: workflow_dispatch      # manual trigger, e.g. from the Actions tab

jobs:
  build-qt:
    runs-on: macos-14      
    timeout-minutes: 360   # static Qt builds are slow; adjust as needed

    env:
      INSTALL_DIR: ${{ github.workspace }}/Qt6.5.3-static

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      # Cache the downloaded source tarball + extracted tree across runs
      - name: Cache Qt source
        uses: actions/cache@v4
        with:
          path: ~/qt-build
          key: qt-src-6.5.3

      - name: Build static Qt
        run: ./scripts/Qt/macos/build-qt-static-macos.sh
        env:
          INSTALL_DIR: ${{ env.INSTALL_DIR }}

      # Upload the tarball of the static built: $INSTALL_DIR.tar.xz
      - name: Upload built Qt as artifact
        uses: actions/upload-artifact@v4
        with:
          name: Qt6.5.3-static
          path: ${{ env.INSTALL_DIR }}.tar.xz
          retention-days: 5